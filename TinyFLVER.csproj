<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<UseWindowsForms>True</UseWindowsForms>
		<ImplicitUsings>Enable</ImplicitUsings>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<LangVersion>13</LangVersion>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
  
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" />
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'" />
  
	<ItemGroup>
	  <None Remove=".gitignore" />
	  <None Remove="Icon.ico" />
	  <None Remove="README.md" />
	  <None Remove="Screenshot.png" />
	  <None Remove="ColorSlider.dll" />
	  <None Remove="AssimpNet.dll" />
	  <None Remove="SoulsFormats.dll" />
	  <Content Include="Icon.ico" />
	  
	  
  	  <PackageReference Include="AssimpNet" Version="4.1.0" />
	  <PackageReference Include="DSoft.SharpDX.Desktop" Version="4.4.2504.231" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	  <PackageReference Include="Pfim" Version="0.11.4" />
	  <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
	  <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
	  <PackageReference Include="SharpDX.DirectComposition" Version="4.2.0" />
	  <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.3" />

	  <Reference Include="AssimpNet" HintPath="AssimpNet.dll" />
	  <Reference Include="ColorSlider" HintPath="ColorSlider.dll" />
	  <Reference Include="SoulsFormats" HintPath="SoulsFormats.dll" />
	  
	  <None Update="Acrylic.dll" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="SoulsFormats.dll" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="AssimpNet.dll" CopyToOutputDirectory="PreserveNewest" />  
	  <None Update="ColorSlider.dll" CopyToOutputDirectory="PreserveNewest" />
	  
	  <None Update="Shaders\PS.BlinnPhong.hlsl" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="Shaders\PS.PBR.hlsl" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="Shaders\Spheres.hlsl" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="Shaders\Outline.hlsl" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="Shaders\VS.hlsl" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>